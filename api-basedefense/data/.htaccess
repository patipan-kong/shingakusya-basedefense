# Save files are only meant to be read/written through index.php.
# Block direct HTTP access to this directory so member_id/save contents
# can't be enumerated or fetched by requesting the .json files directly.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
